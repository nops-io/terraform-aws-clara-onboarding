variable "client_id" {
  type        = string
  description = "Clara client id. Used in the integration role name (nops-integration-role-<client_id>). Comes from GET /api/v1/aws/context once that endpoint exists."

  validation {
    condition     = can(regex("^[0-9]+$", var.client_id))
    error_message = "client_id must be digits only."
  }
}

variable "data_connector_principal_arn" {
  type        = string
  description = "Clara data connector role that assumes the integration role. Prod: arn:aws:iam::861341088565:role/nops-data-connector."

  validation {
    condition     = can(regex("^arn:aws:iam::[0-9]{12}:role/.+$", var.data_connector_principal_arn))
    error_message = "data_connector_principal_arn must be an IAM role ARN."
  }
}

variable "external_id" {
  type        = string
  sensitive   = true
  description = "ExternalId for the trust policy. Generated by the caller (random_uuid) and registered with Clara."

  validation {
    condition     = length(var.external_id) >= 8
    error_message = "external_id must be at least 8 characters."
  }
}

variable "permission_mode" {
  type        = string
  description = "minimal = Savings Analysis (Minimum Platform). full = Full Platform (Inform & Operate)."

  validation {
    condition     = contains(["minimal", "full"], var.permission_mode)
    error_message = "permission_mode must be \"minimal\" or \"full\"."
  }
}

variable "cur_bucket_name" {
  type        = string
  description = "S3 bucket for Legacy CUR and CUR 2.0 delivery. Created by this module in us-east-1. Must be globally unique."

  validation {
    condition     = can(regex("^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$", var.cur_bucket_name))
    error_message = "cur_bucket_name must be a valid S3 bucket name."
  }
}

variable "create_legacy_cur" {
  type        = bool
  description = "Create the Legacy CUR report definition. Clara's Savings Analysis requires it."
  default     = true
}

variable "cur_report_name" {
  type        = string
  description = "Legacy CUR report name. Empty means nops_cur_<client_id>_hourly."
  default     = ""
}

variable "cur_s3_prefix" {
  type        = string
  description = "S3 prefix for the Legacy CUR. Matches the CloudFormation default."
  default     = "nops-cur"
}

variable "create_cur2" {
  type        = bool
  description = "Create the CUR 2.0 (BCM data export) in the same bucket. Required for Clara's Bedrock details."
  default     = false
}

variable "cur2_export_name" {
  type        = string
  description = "CUR 2.0 export name. Empty means nops_cur2_<client_id>_hourly."
  default     = ""
}

variable "cur2_s3_prefix" {
  type        = string
  description = "S3 prefix for CUR 2.0. Matches the CloudFormation default."
  default     = "nops-cur2"
}

variable "iam_propagation_wait" {
  type        = string
  description = "Wait after IAM changes before anything verifies the role."
  default     = "45s"
}

variable "tags" {
  type        = map(string)
  description = "Tags applied to resources that support them."
  default     = {}
}
